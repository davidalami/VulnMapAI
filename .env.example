# Self-hosted / OpenAI-compatible LLM (Chat Completions API).
# Copy this file to .env and fill in your endpoint. The Advisor sends standard
# POST /chat/completions requests, so any OpenAI-compatible server works
# (vLLM, Ollama, LocalAI, LM Studio, or OpenAI itself).

# Full Chat Completions endpoint URL, e.g. http://localhost:8000/v1/chat/completions
LLM_URL=

# Bearer token for the endpoint
LLM_KEY=

# Model id served by the endpoint (optional; defaults to deepseek-ai/DeepSeek-V4-Flash-0731)
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
