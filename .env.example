# OpenAI-compatible LLM configs (Chat Completions API, including self-hosted providers, 
# e.g. vLLM, Ollama, LocalAI, LM Studio, or OpenAI itself).

# Full Chat Completions endpoint URL, e.g. http://localhost:8000/v1/chat/completions
LLM_URL=

# Bearer token for the endpoint
LLM_KEY=

# Model id served by the endpoint, e.g. deepseek-ai/DeepSeek-V4-Flash-0731
LLM_MODEL=
